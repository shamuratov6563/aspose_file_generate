# ---- Soff API ----
TOKEN=
BASE_URL=https://soff.uz

# ---- Queue scope ----
LIMIT=10000
START_ID=1195807
WORKER_COUNT=4

# ---- HTTP ----
# Per-request timeout for download / metadata / upload calls (seconds)
REQUEST_TIMEOUT_SECONDS=120

# Retries happen INSIDE one request, where the per-document budget cannot stop
# them, so the worst case for a single call is
#   (HTTP_RETRY_TOTAL + 1) * REQUEST_TIMEOUT_SECONDS + backoff
# With the defaults below that is 6 * 120 + 8 = 728s. Lower HTTP_RETRY_TOTAL
# whenever DOC_TOTAL_TIMEOUT_SECONDS is tight -- the script prints the computed
# worst case on startup and warns when it exceeds the budget.
HTTP_RETRY_TOTAL=5
HTTP_RETRY_BACKOFF_FACTOR=0.5
HTTP_RETRY_BACKOFF_MAX_SECONDS=30
# A 429 may carry `Retry-After: 600`, which urllib3 obeys literally and no
# timeout here can cut short. Set to 0 to ignore it and use our backoff instead.
HTTP_RESPECT_RETRY_AFTER=1

# ---- Generation timeout ----
# Budget for one LibreOffice conversion, scaled by file size:
#   timeout = clamp(LIBREOFFICE_TIMEOUT_SECONDS + size_mb * PER_MB, MIN, MAX)
# Example with the defaults below: a 10MB file gets 180 + 150 = 330s,
# a 200MB file is capped at 1800s instead of asking for ~3200s.
LIBREOFFICE_TIMEOUT_SECONDS=180
LIBREOFFICE_TIMEOUT_PER_MB_SECONDS=15
LIBREOFFICE_TIMEOUT_MIN_SECONDS=120
# Hard ceiling, 0 = no ceiling. Lower it so one stuck document cannot hold a
# worker for long; raise it on a fast dedicated box with big decks.
LIBREOFFICE_TIMEOUT_MAX_SECONDS=1800

# How often the monitor loop prints "Processing... (Ns elapsed)"
LIBREOFFICE_PROGRESS_INTERVAL_SECONDS=5
# How long to wait for a killed LibreOffice process to actually exit
LIBREOFFICE_KILL_WAIT_SECONDS=5

# ---- Per-document budget ----
# Overall ceiling for one document across every stage (metadata, download,
# convert, repair + retry, rasterize). Each stage gets the smaller of its own
# limit and what is left of this, so one bad document cannot hold a worker for
# much longer than this. 0 = no overall ceiling.
# Keep it above LIBREOFFICE_TIMEOUT_MAX_SECONDS, otherwise it is the only limit
# that ever applies. The final upload is exempt (the images already exist by
# then), so a run can overshoot by at most REQUEST_TIMEOUT_SECONDS.
DOC_TOTAL_TIMEOUT_SECONDS=2400
# Do not start a stage with less than this left -- fail fast instead.
DOC_BUDGET_MIN_STAGE_SECONDS=10

# ---- Memory ----
# Nominal limit in MB; RLIMIT_AS is set to 3x this (virtual != resident)
LIBREOFFICE_MEMORY_LIMIT_MB=3072

# ---- Failure log ----
FAILED_LOG=failed_doc_ids.log
